{
  "version": 2,
  "builds": [
    {
      "src": "public/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "public/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/notificacao/produtos-proximo-vencimento",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/notificacao/iniciar-acao",
      "schedule": "40 2 * * *"
    }
  ]
}