{
  "name": "backend-pastoral-social",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "ENVIRONMENT=local node ./src/server.js",
    "start:dev": "ENVIRONMENT=local nodemon ./src/server.js",
    "build": "rimraf dist-tsc && tsc --emitDecoratorMetadata --experimentalDecorators --outDir dist-tsc && ENVIRONMENT=local node esbuild.config.mjs && rimraf dist-tsc",
    "vercel-build": "rimraf public && rimraf dist-tsc && tsc --emitDecoratorMetadata --experimentalDecorators --outDir dist-tsc && ENVIRONMENT=production node esbuild.config.mjs && rimraf dist-tsc"
  },
  "vercel": {
    "installCommand": "npm install && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@casl/ability": "^6.7.3",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cron": "^4.4.0",
    "express": "^5.1.0",
    "pg": "^8.11.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cron": "^2.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.14",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.10",
    "esbuild-plugin-node-externals": "^1.0.1",
    "nodemon": "^3.1.10",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2"
  }
}
